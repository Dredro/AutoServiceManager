<Window x:Class="Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800">


    <Grid>
        <!-- Definiujemy 2 rzędy: górny dla navbara, dolny dla Frame -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Navbar -->
            <RowDefinition Height="*"/>
            <!-- Zawartość -->
        </Grid.RowDefinitions>

        <!-- Navbar -->
        <StackPanel Orientation="Horizontal" 
                    Background="#1877" 
                    Margin="0,0,0,10"
                    Grid.Row="0">
            <!-- Umieszczamy w pierwszym rzędzie -->
            <Button Content="Dashboard" Click="NavigateToDashboard" Style="{StaticResource NavButton}" />
            <Button Content="Settings" Click="NavigateToSettings" Style="{StaticResource NavButton}" />
            <Button Content="Logout" Click="Logout" Style="{StaticResource NavButton}" />
        </StackPanel>

        <!-- Frame do ładowania stron -->
        <Frame Name="MainFrame" 
               NavigationUIVisibility="Hidden" 
               Grid.Row="1"/>
        <!-- Umieszczamy w drugim rzędzie -->
    </Grid>
</Window>
<UserControl x:Class="Wpf.Views.StorageManager.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf.Views.StorageManager"
             xmlns:vm="clr-namespace:Wpf.ViewModels.StorageManager" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:converters="clr-namespace:Wpf.Core"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">


    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="TextBlock" x:Key="PageTitleStyle">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitleStyle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="Border" x:Key="SectionBorderStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="ListBox" x:Key="StyledListBoxStyle">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDE1E6"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="MinHeight" Value="200"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ListBoxItem" x:Key="StyledListBoxItemStyle">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EEE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="Bd"
                             Padding="{TemplateBinding Padding}"
                             Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"
                             SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="LightSkyBlue"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#E6F2FF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="true"/>
                                    <Condition Property="Selector.IsSelectionActive" Value="false"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#D8D8D8"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Panel Zarządzania Magazynem" Style="{StaticResource PageTitleStyle}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
            <Button Content="Dodaj Nową Część"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AddPartCommand}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Kolumna Lista Części -->
            <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Lista Dostępnych Części" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBox Margin="0,0,0,10" Padding="5"
                             Text="{Binding AvailablePartsSearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AvailablePartsView.RefreshCommand}"/>
                        </TextBox.InputBindings>
                        <i:Interaction.Triggers> <!-- NEW -->
                            <i:EventTrigger EventName="GotFocus"> <!-- NEW -->
                                <i:InvokeCommandAction Command="{Binding SearchTextBoxGotFocusCommand}" CommandParameter="AvailableParts"/> <!-- NEW -->
                            </i:EventTrigger> <!-- NEW -->
                            <i:EventTrigger EventName="LostFocus"> <!-- NEW -->
                                <i:InvokeCommandAction Command="{Binding SearchTextBoxLostFocusCommand}" CommandParameter="AvailableParts"/> <!-- NEW -->
                            </i:EventTrigger> <!-- NEW -->
                        </i:Interaction.Triggers> <!-- NEW -->
                    </TextBox>
                    <ListBox ItemsSource="{Binding AvailablePartsView}"
                             SelectedItem="{Binding SelectedAvailablePart, Mode=TwoWay}"
                             Style="{StaticResource StyledListBoxStyle}"
                             ItemContainerStyle="{StaticResource StyledListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CatalogNumber, StringFormat=' ({0})'}" Margin="5,0,0,0" Foreground="Gray"/>
                                    <TextBlock Text="{Binding QuantityInStock, StringFormat=' - Ilość: {0}'}" Margin="5,0,0,0" Foreground="DimGray"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Kolumna Lista Brakujących Części -->
            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Lista Brakujących Części" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBox Margin="0,0,0,10" Padding="5"
                             Text="{Binding MissingPartsSearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding MissingPartsView.RefreshCommand}"/>
                        </TextBox.InputBindings>
                        <i:Interaction.Triggers> <!-- NEW -->
                            <i:EventTrigger EventName="GotFocus"> <!-- NEW -->
                                <i:InvokeCommandAction Command="{Binding SearchTextBoxGotFocusCommand}" CommandParameter="MissingParts"/> <!-- NEW -->
                            </i:EventTrigger> <!-- NEW -->
                            <i:EventTrigger EventName="LostFocus"> <!-- NEW -->
                                <i:InvokeCommandAction Command="{Binding SearchTextBoxLostFocusCommand}" CommandParameter="MissingParts"/> <!-- NEW -->
                            </i:EventTrigger> <!-- NEW -->
                        </i:Interaction.Triggers> <!-- NEW -->
                    </TextBox>
                    <ListBox ItemsSource="{Binding MissingPartsView}"
                             SelectedItem="{Binding SelectedMissingPart, Mode=TwoWay}"
                             Style="{StaticResource StyledListBoxStyle}"
                             ItemContainerStyle="{StaticResource StyledListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CatalogNumber, StringFormat=' ({0})'}" Margin="5,0,0,0" Foreground="Gray"/>
                                    <TextBlock Text="{Binding QuantityInStock, StringFormat=' - Ilość: {0}'}" Margin="5,0,0,0" Foreground="Red"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Dodaj Zaznaczone"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,15,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding OrderSelectedMissingPartsCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3" Grid.ColumnSpan="3" Background="#AAFFFFFF" Panel.ZIndex="1"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                             HorizontalAlignment="Center" Width="50" Height="50" Margin="0,0,0,10"/>
                <TextBlock Text="Ładowanie danych..." FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
<UserControl x:Class="Wpf.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Wpf.Views"
      xmlns:core="clr-namespace:Wpf.Core"
      mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="800"
      Background="#f7f5f1">

    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Border Background="White"
                CornerRadius="10"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="400" Width="358">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Logowanie"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Email -->
                <TextBlock Text="Email:"
                           FontSize="14"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="EmailTextBox"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Height="35"
                         FontSize="14"
                         Padding="5"
                         BorderThickness="1"
                         BorderBrush="Gray"
                         Margin="0,0,0,2"/>
                <TextBlock Text="{Binding EmailValidationError}"
                           Foreground="Red"
                           FontSize="12"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"/>

                <!-- Hasło -->
                <TextBlock Text="Hasło:"
                           FontSize="14"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox"
                             core:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             FontSize="14"
                             Padding="5"
                             BorderThickness="1"
                             BorderBrush="Gray"
                             Margin="0,0,0,2"/>
                <TextBlock Text="{Binding PasswordValidationError}"
                           Foreground="Red"
                           FontSize="12"
                           Margin="0,0,0,15"
                           TextWrapping="Wrap"/>

                <!-- Przycisk Zaloguj -->
                <Button Content="Zaloguj"
                        Height="40"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="DodgerBlue"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding LoginCommand}">
                    <!-- IsEnabled jest automatycznie zarządzane przez CanExecute komendy -->
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Komunikat o błędach logowania (z serwera) -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           FontSize="12"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
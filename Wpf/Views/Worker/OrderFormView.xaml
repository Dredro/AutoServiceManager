<UserControl x:Class="Wpf.Views.Worker.OrderFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="600">
    <ScrollViewer>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Nagłówek -->
            <TextBlock Grid.Row="0" Text="{Binding Title}" 
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Margin="0,0,0,16"/>

            <!-- Informacje o kliencie -->
            <materialDesign:Card Grid.Row="1" Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <TextBlock Text="Klient" Margin="0,0,0,16" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nazwa:" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OrderS.Customer.Name}" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OrderS.Customer.Email}" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Telefon:" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrderS.Customer.Phone}" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Informacje o pojeździe -->
            <materialDesign:Card Grid.Row="2" Margin="0,0,0,16" >
                <StackPanel Margin="16">
                    <TextBlock Text="Pojazd" Margin="0,0,0,16" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Model:" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OrderS.Vehicle.Model}" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Rocznik:" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OrderS.Vehicle.Year}" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="VIN:" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrderS.Vin}" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Nr rej.:" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OrderS.Vehicle.PlateNumber}" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="3" Padding="10" Margin="0,0,0,16"/>
            <materialDesign:Card Grid.Row="4" Margin="0,0,0,16"/>
            <materialDesign:Card Grid.Row="5" Margin="0,0,0,16"/>
            <materialDesign:Card Grid.Row="6" Margin="0,0,0,16"/>
            <!-- Status i mechanik -->
            <Grid Grid.Row="3" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Margin="0,0,8,0"
                          materialDesign:HintAssist.Hint="Status zlecenia"
                          ItemsSource="{Binding OrderStatus}"
                          SelectedItem="{Binding OrderS.Status}"/>

                <ComboBox Grid.Column="1" Margin="8,0,0,0"
                          materialDesign:HintAssist.Hint="Przypisany mechanik"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding AvailableMechanics}"
                          SelectedItem="{Binding OrderS.AssignedMechanic}"/>
            </Grid>


            <!-- Daty -->
            <Grid Grid.Row="4" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DatePicker Grid.Column="0" Margin="0,0,8,0"
                            materialDesign:HintAssist.Hint="Data utworzenia"
                            SelectedDate="{Binding OrderS.CreatedOn}" IsEnabled="False"/>

                <DatePicker Grid.Column="1" Margin="8,0,8,0"
                            materialDesign:HintAssist.Hint="Data rozpoczęcia"
                            SelectedDate="{Binding OrderS.StartedOn}"/>

                <DatePicker Grid.Column="2" Margin="8,0,0,0"
                            materialDesign:HintAssist.Hint="Data zakończenia"
                            SelectedDate="{Binding OrderS.CompletedOn}"/>
            </Grid>

            <!-- Opis prac -->
            <TextBox Grid.Row="5" Margin="16,0,16,16"
                     materialDesign:HintAssist.Hint="Opis prac"
                     Text="{Binding OrderS.DescriptionOfWork}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>

            <!-- Uwagi -->
            <TextBox Grid.Row="6" Margin="16,0,16,16"
                     materialDesign:HintAssist.Hint="Uwagi"
                     Text="{Binding OrderS.Remarks}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>

            <!-- Lista usług -->
            <materialDesign:Card Grid.Row="7" Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <TextBlock Text="Usługi" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>
                        <Button Content="Dodaj usługę" Margin="16,0,0,0" Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding AddServiceCommand}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding OrderS.Services}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Usługa" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableServices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="ServiceName"
                                                  SelectedItem="{Binding Service}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Akcje" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{materialDesign:PackIcon Kind=Delete}" 
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Lista części -->
            <materialDesign:Card Grid.Row="8" Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <TextBlock Text="Części zamienne" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>
                        <Button Content="Dodaj część" Margin="16,0,0,0" Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding AddPartCommand}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Order.ReplacementParts}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Część" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableParts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="PartName"
                                                  SelectedItem="{Binding Part}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ilość" Binding="{Binding Quantity}" Width="Auto"/>
                            <DataGridTextColumn Header="Uwagi" Binding="{Binding Note}" Width="*"/>
                            <DataGridTemplateColumn Header="Akcje" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{materialDesign:PackIcon Kind=Delete}" 
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.RemovePartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Podsumowanie -->
            <materialDesign:Card Grid.Row="9" Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <TextBlock Text="Podsumowanie" Margin="0,0,0,16" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Łączny koszt usług:" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServicesTotalCost, StringFormat={}{0:C}}" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Łączny koszt części:" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PartsTotalCost, StringFormat={}{0:C}}" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Suma:" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Order.TotalCost, StringFormat={}{0:C}}" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Przyciski akcji -->
            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Anuluj" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
                <Button Content="Zapisz" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

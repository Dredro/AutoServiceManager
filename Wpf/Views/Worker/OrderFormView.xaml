<UserControl x:Class="Wpf.Views.Worker.OrderFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="600">
    <ScrollViewer>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Nagłówek -->
            <TextBlock Grid.Row="0" Text="{Binding Title}"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}" Foreground="White" Background="DarkBlue"
                       Margin="0,0,0,16"/>

            <!-- Informacje o kliencie -->
            <materialDesign:Card Grid.Row="1" Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Klient" Grid.Column="0" Margin="0,0,0,16" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>


                        <Button Content="Dodaj"
                                Name="AddNewClientButton" Grid.Column="1" Margin="0,0,0,16" Click="AddNewClientButton_Click">
                            <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Dodaj"/>
                                </StackPanel>
                            </DataTemplate>
                            </Button.ContentTemplate>
                            </Button>
                    </Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Margin="0,0,0,16"
                            materialDesign:HintAssist.Hint="Wyszukaj klienta"
                            Text="{Binding SearchCustomersString, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="False" TextWrapping="Wrap" MinHeight="20"/>

                        <DataGrid ItemsSource="{Binding Model.SearchedClients}" AutoGenerateColumns="False" Grid.Row="1"
                            CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="200"
                            SelectedItem="{Binding SelectedClient}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Imię" Binding="{Binding PersonalInfo.FirstName}" Width="*"/>
                                <DataGridTextColumn Header="Nazwisko" Binding="{Binding PersonalInfo.LastName}" Width="*"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding PersonalInfo.Email}" Width="*"/>
                                <DataGridTextColumn Header="Telefon" Binding="{Binding PersonalInfo.PhoneNumber}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Margin="0,16,0,0" Visibility="{Binding SelectedClient, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="Wybrany klient:" Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            <TextBlock Text="{Binding SelectedClient.PersonalInfo.FirstName}" Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            <TextBlock Text="{Binding SelectedClient.PersonalInfo.LastName}" Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Informacje o pojeździe -->
            <materialDesign:Card Grid.Row="2" Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pojazd" Margin="0,0,0,16" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>
                        <Button Content="Dodaj"
                                Name="AddNewVehicleButton" Grid.Column="1" Margin="0,0,0,16" Click="AddNewVehicleButton_Click">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="Dodaj"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </Grid>
                    

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Margin="0,0,0,16"
                            materialDesign:HintAssist.Hint="Wyszukaj pojazd"
                            Text="{Binding SearchVehicleString, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="False" TextWrapping="Wrap" MinHeight="20"
                            IsEnabled="{Binding SelectedClient, Converter={StaticResource NullToBooleanConverter}}"/>

                        <DataGrid ItemsSource="{Binding Model.SearchedVehicles}" AutoGenerateColumns="False" Grid.Row="1"
                            CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="200"
                            SelectedItem="{Binding SelectedVehicle}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Marka" Binding="{Binding Make}" Width="*"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                                <DataGridTextColumn Header="Nr rejestracyjny" Binding="{Binding RegistrationNumber}" Width="*"/>
                                <DataGridTextColumn Header="Rok" Binding="{Binding YearOfProduction}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Margin="0,16,0,0" Visibility="{Binding SelectedVehicle, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="Wybrany pojazd:" Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}">
                                <Run Text="{Binding SelectedVehicle.Make}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedVehicle.Model}"/>
                                <Run Text=" ("/>
                                <Run Text="{Binding SelectedVehicle.RegistrationNumber}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Status i data finalizacji -->
            <materialDesign:Card Grid.Row="3" Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <TextBlock Text="Informacje o zleceniu" Margin="0,0,0,16" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Content="Opłacone" 
                                  IsChecked="{Binding Model.Order.IsPaid}" 
                                  Margin="0,0,8,0"/>

                        <DatePicker Grid.Column="1" Margin="8,0,0,0"
                                    materialDesign:HintAssist.Hint="Data finalizacji"
                                    SelectedDate="{Binding Model.Order.FinalizationDate}"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Lista usług -->
            <materialDesign:Card Grid.Row="4" Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <TextBlock Text="Usługi" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>
                        <Button Content="Dodaj usługę" Margin="16,0,0,0" Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding AddServiceCommand}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Model.Order.ServicesToDo}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Usługa" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Model.AvailableServices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding Service, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Cena" Binding="{Binding Price, StringFormat=C}" Width="Auto"/>
                            <DataGridTemplateColumn Header="Status" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Model.ServiceStatusList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding ServiceStatus, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Pracownicy" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Model.AvailableMechanics, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="PersonalInfo.FirstName"
                                                  SelectedItem="{Binding DataContext.SelectedMechanic, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Akcje" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{materialDesign:PackIcon Kind=Delete}" 
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Lista części -->
            <materialDesign:Card Grid.Row="5" Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <TextBlock Text="Części zamienne" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>
                        <Button Content="Dodaj część" Margin="16,0,0,0" Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding AddPartCommand}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Model.Order.SpareParts}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Część" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Model.AvailableParts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SparePart, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ilość" Binding="{Binding Quantity}" Width="Auto"/>
                            <DataGridTextColumn Header="Cena jednostkowa" Binding="{Binding SparePart.Price, StringFormat=C}" Width="Auto" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Suma" Width="Auto" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0:C}">
                                        <Binding Path="SparePart.Price"/>
                                        <Binding Path="Quantity"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Akcje" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{materialDesign:PackIcon Kind=Delete}" 
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.RemovePartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Dodatkowe informacje -->
            <materialDesign:Card Grid.Row="6" Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <TextBlock Text="Dodatkowe informacje" Margin="0,0,0,16" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Opis prac -->
                        <TextBox Grid.Row="0" Margin="0,0,0,16"
                                 materialDesign:HintAssist.Hint="Opis wykonanych prac"
                                 Text="{Binding Model.DescriptionOfWork}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>

                        <!-- Uwagi -->
                        <TextBox Grid.Row="1"
                                 materialDesign:HintAssist.Hint="Uwagi dodatkowe"
                                 Text="{Binding Model.Remarks}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Podsumowanie -->
            <materialDesign:Card Grid.Row="7" Margin="0,0,0,16">
                <StackPanel Margin="16">
                    <TextBlock Text="Podsumowanie" Margin="0,0,0,16" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Łączny koszt usług:" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Model.ServicesTotalCost, StringFormat=C}" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Łączny koszt części:" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Model.PartsTotalCost, StringFormat=C}" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,0,0,8"/>

                        <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Suma całkowita:" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,8,8,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,8,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:C}">
                                    <Binding Path="Model.ServicesTotalCost"/>
                                    <Binding Path="Model.PartsTotalCost"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Przyciski akcji -->
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Anuluj" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
                <Button Content="Zapisz" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
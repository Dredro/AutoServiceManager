<Window x:Class="Wpf.Views.Worker.OrderEditDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        xmlns:models="clr-namespace:Wpf.Models.DTOs">
    <Window.Resources>
        <x:Array x:Key="ServiceStatusValues" Type="models:ServiceStatus">
            <models:ServiceStatus>PendingForStart</models:ServiceStatus>
            <models:ServiceStatus>PendingForParts</models:ServiceStatus>
            <models:ServiceStatus>InProgress</models:ServiceStatus>
            <models:ServiceStatus>Completed</models:ServiceStatus>
        </x:Array>
    </Window.Resources>
    <Border Padding="16" Background="{DynamicResource MaterialDesignPaper}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Nagłówek -->
            <TextBlock Grid.Row="0" Text="{Binding Title}"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       Margin="0,0,0,16"/>

            <!-- Formularz -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Sekcja klienta i pojazdu -->
                    <GroupBox Header="Klient i pojazd" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Klient -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBox materialDesign:HintAssist.Hint="Imię klienta" 
                                         Text="{Binding Order.Client.PersonalInfo.FirstName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox materialDesign:HintAssist.Hint="Nazwisko klienta" 
                                         Text="{Binding Order.Client.PersonalInfo.LastName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,8,0,0"/>

                                <TextBox materialDesign:HintAssist.Hint="Email" 
                                         Text="{Binding Order.Client.PersonalInfo.Email, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Pojazd -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBox materialDesign:HintAssist.Hint="Marka pojazdu" 
                                         Text="{Binding Order.Vehicle.Make, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox materialDesign:HintAssist.Hint="Model pojazdu" 
                                         Text="{Binding Order.Vehicle.Model, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,8,0,0"/>

                                <TextBox materialDesign:HintAssist.Hint="Numer rejestracyjny" 
                                         Text="{Binding Order.Vehicle.RegistrationNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Sekcja usług -->
                    <GroupBox Header="Usługi do wykonania" Margin="0,0,0,16">
                        <StackPanel>
                            <DataGrid ItemsSource="{Binding Order.ServicesToDo}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Usługa" Width="auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.AvailableServices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          SelectedItem="{Binding Service}"
                                                          DisplayMemberPath="Name"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Cena" Binding="{Binding Price, StringFormat={}{0:C}}" Width="Auto"/>
                                    <DataGridComboBoxColumn Header="Status" 
                                                            SelectedItemBinding="{Binding ServiceStatus}"
                                                            ItemsSource="{Binding Source={StaticResource ServiceStatusValues}}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Content="Dodaj usługę" Command="{Binding AddServiceCommand}"
                                    HorizontalAlignment="Right" Margin="0,8,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Dodaj usługę"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </GroupBox>

                    <!-- Sekcja części zamiennych -->
                    <GroupBox Header="Części zamienne" Margin="0,0,0,16">
                        <StackPanel>
                            <DataGrid ItemsSource="{Binding Order.SpareParts}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Część" Width="auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.AvailableParts, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          SelectedItem="{Binding SparePart}"
                                                          DisplayMemberPath="Name"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Ilość" Binding="{Binding Quantity}" Width="Auto"/>
                                    <DataGridTextColumn Header="Cena jednostkowa" Binding="{Binding SparePart.Price, StringFormat={}{0:C}}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Content="Dodaj część" Command="{Binding AddPartCommand}"
                                    HorizontalAlignment="Right" Margin="0,8,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Dodaj część"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Przyciski akcji -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Anuluj" Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0"/>

                <Button Content="Zapisz" Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource PrimaryHueMidBrush}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Zapisz"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
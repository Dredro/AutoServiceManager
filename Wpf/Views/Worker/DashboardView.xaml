<UserControl x:Class="Wpf.Views.Worker.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <ScrollViewer Margin="10">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Panel Serwisanta" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontSize="25" Margin="10" />

            <!-- Statystyki -->
            <materialDesign:Card Grid.Row="1" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:Card Margin="8" Width="200"  Background="Gray">
                        <StackPanel Margin="8">
                            <TextBlock Text="Aktywne zlecenia" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Foreground="White"/>
                            <TextBlock Text="{Binding DataModel.ActiveOrders}" Style="{StaticResource MaterialDesignHeadline4TextBlock}" HorizontalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Margin="8" Width="200"  Background="Gray">
                        <StackPanel Margin="8">
                            <TextBlock Text="Świadczonych usług" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Foreground="White"/>
                            <TextBlock Text="{Binding DataModel.ServicesProvided}" Style="{StaticResource MaterialDesignHeadline4TextBlock}" HorizontalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Margin="8" Width="200"  Background="Gray">
                        <StackPanel Margin="8">
                            <TextBlock Text="Zlecenia dzisiaj" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Foreground="White"/>
                            <TextBlock Text="{Binding DataModel.OrdersToday}" Style="{StaticResource MaterialDesignHeadline4TextBlock}" HorizontalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Twoje aktywne zlecenia" 
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                       Margin="8"/>
                    </StackPanel>
                    <Grid>
                        <DataGrid ItemsSource="{Binding DataModel.Orders}" 
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  materialDesign:DataGridAssist.CellPadding="16 8 8 8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                            <DataGrid.Columns>

                                <!-- Kolumna z podstawowymi informacjami -->
                                <DataGridTemplateColumn Header="Zlecenie">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DescriptionOfWork}" 
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           FontSize="16"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="Klient:" Margin="0,0,4,0"
                                               Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                                                    <TextBlock Text="{Binding Client.FirstName}"
                                               Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Pojazd:" Margin="0,0,4,0"
                                               Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                                                    <TextBlock Text="{Binding Vehicle.Type}"
                                               Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Kolumna statusu -->
                                <DataGridTemplateColumn Header="Status" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" 
                                       Style="{StaticResource MaterialDesignBody1TextBlock}"
                                       HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Kolumna kosztu -->
                                <DataGridTextColumn Header="Koszt" 
                                   Binding="{Binding TotalCost, StringFormat={}{0:C}}"
                                   Width="Auto"/>
                            </DataGrid.Columns>

                            <!-- Szczegóły rozwijane -->
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="16 8 16 16">
                                        <TextBlock Text="Usługi do wykonania:" 
                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Margin="0 0 0 8"/>

                                        <DataGrid ItemsSource="{Binding ServicesToDo}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="None"
                                  BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding Service.Name}"/>
                                                <DataGridTextColumn Binding="{Binding Price, StringFormat={}{0:C}}"/>
                                                <DataGridTemplateColumn>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding ServiceStatus}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="3">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Świadczone usługi" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="8"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding DataModel.Services}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Opis" Binding="{Binding Description}"/>
                            <DataGridTextColumn Header="Cena minimalna" 
                                   Binding="{Binding MinimalPrice, StringFormat={}{0:C}}"/>
                            <DataGridTextColumn Header="Cena maksymalna" 
                                   Binding="{Binding MaximalPrice, StringFormat={}{0:C}}"/>
                            <DataGridTextColumn Header="Kategoria" Binding="{Binding Category}"/>
                            <DataGridTextColumn Header="Aktywne" 
                                   Binding="{Binding ServicesInProgress.Count}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>

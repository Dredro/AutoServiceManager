<Window x:Class="Wpf.Views.Worker.OrderDetailsDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Wpf.Core"
        WindowStartupLocation="CenterOwner">

    <Border Padding="16" Background="{DynamicResource MaterialDesignPaper}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Nagłówek -->
            <TextBlock Grid.Row="0" Text="{Binding Title}"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       Margin="0,0,0,16"/>

            <!-- Szczegóły -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Informacje podstawowe -->
                    <materialDesign:Card Margin="0,0,0,16">
                        <materialDesign:Card.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Order.Status}" FontWeight="Bold"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Klient:" Margin="0,8,8,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Order.Client.PersonalInfo.FirstName}" 
                                           Margin="0,8,0,0" FontWeight="Bold"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Pojazd:" Margin="0,8,8,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" 
                                           Text="{Binding Order.Vehicle.Model}"
                                           Margin="0,8,0,0" FontWeight="Bold"/>
                            </Grid>
                        </materialDesign:Card.Content>
                    </materialDesign:Card>

                    <!-- Usługi -->
                    <GroupBox Header="Usługi">
                        <DataGrid ItemsSource="{Binding Order.ServicesToDo}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nazwa" Binding="{Binding Service.Name}" Width="Auto"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding ServiceStatus}" Width="Auto"/>
                                <DataGridTextColumn Header="Cena" Binding="{Binding Price, StringFormat={}{0:C}}" Width="auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Części zamienne -->
                    <GroupBox Header="Części zamienne" Margin="0,16,0,0">
                        <DataGrid ItemsSource="{Binding Order.SpareParts}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nazwa" Binding="{Binding SparePart.Name}" Width="auto"/>
                                <DataGridTextColumn Header="Ilość" Binding="{Binding Quantity}" Width="Auto"/>
                                <DataGridTextColumn Header="Cena jednostkowa" Binding="{Binding SparePart.Price, StringFormat={}{0:C}}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Podsumowanie -->
                    <!--<materialDesign:Card Margin="0,16,0,0">
                        <materialDesign:Card.Content>
                            <MultiBinding Converter="{StaticResource MultiplyMultiConverter}">
                                <Binding Path="Quantity"/>
                                <Binding Path="SparePart.Price"/>
                            </MultiBinding>
                        </materialDesign:Card.Content>
                    </materialDesign:Card>-->
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
<UserControl x:Class="Wpf.Views.Worker.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <TextBlock Text="Zlecenia serwisowe" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Foreground="White"/>

            <Button Content="Dodaj nowe" Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Right" Margin="16,0,0,0"
                    Command="{Binding AddNewOrderCommand}">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Dodaj nowe"/>
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Orders}" AutoGenerateColumns="False" Margin="10"
                  SelectionMode="Single" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="Klient" Binding="{Binding Client.Email}"/>
                <DataGridTextColumn Header="Pojazd" Binding="{Binding Vehicle.Model}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                <!--<DataGridTextColumn Header="Ukończenia" Binding="{Binding CreatedOn, StringFormat={}{0:dd.MM.yyyy}}"/>-->
                <DataGridTextColumn Header="Koszt" Binding="{Binding TotalCost, StringFormat={}{0:C}}"/>
                <DataGridTemplateColumn Header="Akcje">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                        Content="{materialDesign:PackIcon Kind=BookOpenBlankVariant}" 
                                        ToolTip="Wyświetl"
                                        Command="{Binding DataContext.ShowOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>

                                <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                        Content="{materialDesign:PackIcon Kind=Edit}" 
                                        ToolTip="Edytuj"
                                        Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>

                                <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                        Content="{materialDesign:PackIcon Kind=Delete}" 
                                        ToolTip="Usuń"
                                        Command="{Binding DataContext.DeleteOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

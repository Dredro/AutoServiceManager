<UserControl x:Class="Wpf.Views.EditVehicleForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Wpf.ViewModels" 
             xmlns:converters="clr-namespace:Wpf.Core"
             xmlns:converters1="clr-namespace:Wpf.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="400">

    <UserControl.Resources>
        <converters1:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/> 
        
        <!-- NEW: Combined Boolean to Inverse Boolean Converter -->
        <converters1:MultiBooleanToInverseBooleanConverter x:Key="MultiBooleanToInverseBooleanConverter" />

        <Style x:Key="StackPanelMarginStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Content="Edytuj pojazd" FontSize="24" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1">
                <!-- Apply MultiBooleanToInverseBooleanConverter to inputs -->
                <StackPanel Style="{StaticResource StackPanelMarginStyle}">
                    <ComboBox materialDesign:HintAssist.Hint="Rodzaj pojazdu"
                              Style="{StaticResource MaterialDesignComboBox}"
                              ItemsSource="{Binding VehicleTypes}"
                              SelectedItem="{Binding SelectedVehicleType}">
                        <ComboBox.IsEnabled>
                            <MultiBinding Converter="{StaticResource MultiBooleanToInverseBooleanConverter}">
                                <Binding Path="IsSaving"/>
                                <Binding Path="IsLoadingVehicle"/>
                                <Binding Path="IsLoadingClients"/>
                            </MultiBinding>
                        </ComboBox.IsEnabled>
                    </ComboBox>
                </StackPanel>
                <StackPanel Style="{StaticResource StackPanelMarginStyle}">
                    <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:HintAssist.Hint="Marka"
                             Text="{Binding Make, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.IsEnabled>
                            <MultiBinding Converter="{StaticResource MultiBooleanToInverseBooleanConverter}">
                                <Binding Path="IsSaving"/>
                                <Binding Path="IsLoadingVehicle"/>
                            </MultiBinding>
                        </TextBox.IsEnabled>
                    </TextBox>
                </StackPanel>
                <StackPanel  Style="{StaticResource StackPanelMarginStyle}">
                    <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:HintAssist.Hint="Model"
                             Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.IsEnabled>
                            <MultiBinding Converter="{StaticResource MultiBooleanToInverseBooleanConverter}">
                                <Binding Path="IsSaving"/>
                                <Binding Path="IsLoadingVehicle"/>
                            </MultiBinding>
                        </TextBox.IsEnabled>
                    </TextBox>
                </StackPanel>
                <StackPanel  Style="{StaticResource StackPanelMarginStyle}">
                    <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:HintAssist.Hint="VIN"
                             Text="{Binding Vin, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.IsEnabled>
                            <MultiBinding Converter="{StaticResource MultiBooleanToInverseBooleanConverter}">
                                <Binding Path="IsSaving"/>
                                <Binding Path="IsLoadingVehicle"/>
                            </MultiBinding>
                        </TextBox.IsEnabled>
                    </TextBox>
                </StackPanel>
                <StackPanel  Style="{StaticResource StackPanelMarginStyle}">
                    <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:HintAssist.Hint="Numer rejestracyjny"
                             Text="{Binding RegistrationNumber, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.IsEnabled>
                            <MultiBinding Converter="{StaticResource MultiBooleanToInverseBooleanConverter}">
                                <Binding Path="IsSaving"/>
                                <Binding Path="IsLoadingVehicle"/>
                            </MultiBinding>
                        </TextBox.IsEnabled>
                    </TextBox>
                </StackPanel>

                <StackPanel  Style="{StaticResource StackPanelMarginStyle}">
                    <DatePicker materialDesign:HintAssist.Hint="Data rejestracji"
                                SelectedDate="{Binding RegistrationDate}">
                        <DatePicker.IsEnabled>
                            <MultiBinding Converter="{StaticResource MultiBooleanToInverseBooleanConverter}">
                                <Binding Path="IsSaving"/>
                                <Binding Path="IsLoadingVehicle"/>
                            </MultiBinding>
                        </DatePicker.IsEnabled>
                    </DatePicker>
                </StackPanel>
                <StackPanel  Style="{StaticResource StackPanelMarginStyle}">
                    <Label Content="Rok produkcji" />
                    <materialDesign:NumericUpDown Value="{Binding YearOfProduction, UpdateSourceTrigger=PropertyChanged}">
                        <materialDesign:NumericUpDown.IsEnabled>
                            <MultiBinding Converter="{StaticResource MultiBooleanToInverseBooleanConverter}">
                                <Binding Path="IsSaving"/>
                                <Binding Path="IsLoadingVehicle"/>
                            </MultiBinding>
                        </materialDesign:NumericUpDown.IsEnabled>
                    </materialDesign:NumericUpDown>
                </StackPanel>
                <StackPanel  Style="{StaticResource StackPanelMarginStyle}">
                    <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:HintAssist.Hint="Kod silnika"
                             Text="{Binding EngineCode, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.IsEnabled>
                            <MultiBinding Converter="{StaticResource MultiBooleanToInverseBooleanConverter}">
                                <Binding Path="IsSaving"/>
                                <Binding Path="IsLoadingVehicle"/>
                            </MultiBinding>
                        </TextBox.IsEnabled>
                    </TextBox>
                </StackPanel>
                <StackPanel  Style="{StaticResource StackPanelMarginStyle}">
                    <Label Content="Pojemność silnika (wyrażona w cm3)" />
                    <materialDesign:NumericUpDown Value="{Binding EngineDisplacement, UpdateSourceTrigger=PropertyChanged}">
                        <materialDesign:NumericUpDown.IsEnabled>
                            <MultiBinding Converter="{StaticResource MultiBooleanToInverseBooleanConverter}">
                                <Binding Path="IsSaving"/>
                                <Binding Path="IsLoadingVehicle"/>
                            </MultiBinding>
                        </materialDesign:NumericUpDown.IsEnabled>
                    </materialDesign:NumericUpDown>
                </StackPanel>
                <StackPanel Style="{StaticResource StackPanelMarginStyle}">
                    <Label Content="Moc silnika (wyrażona w KM)" />
                    <materialDesign:DecimalUpDown Value="{Binding Power, UpdateSourceTrigger=PropertyChanged}">
                        <materialDesign:DecimalUpDown.IsEnabled>
                            <MultiBinding Converter="{StaticResource MultiBooleanToInverseBooleanConverter}">
                                <Binding Path="IsSaving"/>
                                <Binding Path="IsLoadingVehicle"/>
                            </MultiBinding>
                        </materialDesign:DecimalUpDown.IsEnabled>
                    </materialDesign:DecimalUpDown>
                </StackPanel>

                <StackPanel  Style="{StaticResource StackPanelMarginStyle}">
                    <ComboBox materialDesign:HintAssist.Hint="Wybierz Klienta"
                              Style="{StaticResource MaterialDesignComboBox}"
                              IsEditable="True"
                              ItemsSource="{Binding FilteredClients}"
                              SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                              Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged}"
                              StaysOpenOnEdit="True"         
                              IsTextSearchEnabled="False">
                        <ComboBox.IsEnabled>
                            <MultiBinding Converter="{StaticResource MultiBooleanToInverseBooleanConverter}">
                                <Binding Path="IsSaving"/>
                                <Binding Path="IsLoadingClients"/>
                                <Binding Path="IsLoadingVehicle"/>
                            </MultiBinding>
                        </ComboBox.IsEnabled>
                
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1} (ID: {2})">
                                            <Binding Path="FirstName"/>
                                            <Binding Path="LastName"/>
                                            <Binding Path="Id"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                  
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                IsIndeterminate="True"
                                                HorizontalAlignment="Left" Width="20" Height="20"
                                                Margin="0,5,0,0"
                                                Visibility="{Binding IsLoadingClients, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- NEW: Loading spinner for the vehicle data itself -->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Grid.ColumnSpan="2"
                            Visibility="{Binding IsLoadingVehicle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                                 HorizontalAlignment="Center" Width="40" Height="40" Margin="0,20,0,0"/>
                    <TextBlock Text="Ładowanie danych pojazdu..." HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2">
                <Button Content="Anuluj" Margin="0,0,10,0" Style="{StaticResource MaterialDesignFlatSecondaryButton}"
                        Command="{Binding CancelCommand}">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource MultiBooleanToInverseBooleanConverter}">
                            <Binding Path="IsSaving"/>
                            <Binding Path="IsLoadingVehicle"/>
                            <Binding Path="IsLoadingClients"/>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
                <Button Content="Zapisz" Margin="0,0,10,0" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding SaveCommand}">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource MultiBooleanToInverseBooleanConverter}">
                            <Binding Path="IsSaving"/>
                            <Binding Path="IsLoadingVehicle"/>
                            <Binding Path="IsLoadingClients"/>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Grid.Row="3" Grid.ColumnSpan="2"
                        Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                             HorizontalAlignment="Center" Width="40" Height="40" Margin="0,20,0,0"/>
                <TextBlock Text="Zapisywanie..." HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
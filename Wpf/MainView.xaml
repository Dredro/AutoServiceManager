<UserControl x:Class="Wpf.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:core="clr-namespace:Wpf.Core"
             xmlns:local="clr-namespace:Wpf" 
             xmlns:vms="clr-namespace:Wpf.ViewModels"
             xmlns:viewsAdmin="clr-namespace:Wpf.Views.Admin"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Wpf.ViewModel" 
             mc:Ignorable="d" 
            >

    <UserControl.Resources>
        <core:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- AppBar -->
        <materialDesign:ColorZone Mode="PrimaryDark" Padding="16" Grid.Row="0" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CarWrench" Width="32" Height="32" Margin="0,0,16,0"/>
                    <TextBlock Text="Serwis Samochodowy" FontSize="24" VerticalAlignment="Center"/>

                    <!-- Admin Buttons - KEPT as per your original XAML -->
                    <StackPanel Orientation="Horizontal" Margin="40,0,0,0" Visibility="{Binding IsAdminVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="Dashboard Admina" Style="{StaticResource MaterialDesignFlatButton}" 
                            Command="{Binding SwitchViewCommand}" CommandParameter="Dashboard"/>
                    </StackPanel>

                    <!-- Manager/Owner Buttons - Added "Usługi" -->
                    <StackPanel Orientation="Horizontal" Margin="40,0,0,0" Visibility="{Binding IsManagerVisible, Converter={StaticResource BooleanToVisibilityConverter}}" >
                        <Button Content="Dashboard Właściciela" Style="{StaticResource MaterialDesignFlatButton}" 
                            Command="{Binding SwitchViewCommand}" CommandParameter="Dashboard"/>
                        <Button Content="Zlecenia" Style="{StaticResource MaterialDesignFlatButton}" 
                            Command="{Binding SwitchViewCommand}" CommandParameter="Orders"/>
                        <Button Content="Klienci" Style="{StaticResource MaterialDesignFlatButton}" 
                            Command="{Binding SwitchViewCommand}" CommandParameter="Customers"/>
                        <Button Content="Samochody" Style="{StaticResource MaterialDesignFlatButton}" 
                            Command="{Binding SwitchViewCommand}" CommandParameter="Cars"/>
             
                        <Button Content="Usługi" Style="{StaticResource MaterialDesignFlatButton}" 
                            Command="{Binding SwitchViewCommand}" CommandParameter="Services"/>
                        
                    </StackPanel>

                    <!-- Mechanic Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="40,0,0,0" Visibility="{Binding IsMechanicVisible, Converter={StaticResource BooleanToVisibilityConverter}}" >
                        <Button Content="Dashboard Mechanika" Style="{StaticResource MaterialDesignFlatButton}" 
                            Command="{Binding SwitchViewCommand}" CommandParameter="Dashboard"/>
                        <Button Content="Zlecenia" Style="{StaticResource MaterialDesignFlatButton}" 
                            Command="{Binding SwitchViewCommand}" CommandParameter="Orders"/>
                    </StackPanel>

                    <!-- Storage Manager Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="40,0,0,0" Visibility="{Binding IsStorageManagerVisible, Converter={StaticResource BooleanToVisibilityConverter}}" >
                        <Button Content="Dashboard Magazyniera" Style="{StaticResource MaterialDesignFlatButton}" 
                            Command="{Binding SwitchViewCommand}" CommandParameter="Dashboard"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                    <Button Content="Wyloguj" Style="{StaticResource MaterialDesignFlatButton}" 
                    Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Main Content -->
        <ContentControl Background="Gray" Grid.Row="1" Content="{Binding CurrentContent}"/>
    </Grid>
</UserControl>